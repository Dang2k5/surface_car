{"catalog_id": "VISUAL-QC-FNS-PILOT", "revision": "2026.08.1", "status": "APPROVED", "approval_scope": "DEMO_BASELINE_ONLY", "effective_date": "2026-08-12", "owner": "Quality Engineering", "disclaimer": "Ch\u1ec9 t\u1ea1m th\u1eddi ph\u00ea duy\u1ec7t \u0111\u1ec3 tr\u00ecnh di\u1ec5n baseline v\u00e0 ki\u1ec3m ch\u1ee9ng quy tr\u00ecnh. \u0110\u00e2y KH\u00d4NG ph\u1ea3i th\u1ea9m quy\u1ec1n ph\u00e1t h\u00e0nh s\u1ea3n xu\u1ea5t. Ph\u1ea3i thay th\u1ebf b\u1eb1ng control plan c\u1ee7a OEM v\u00e0 h\u01b0\u1edbng d\u1eabn c\u00f4ng vi\u1ec7c \u0111\u00e3 \u0111\u01b0\u1ee3c ph\u00ea duy\u1ec7t tr\u01b0\u1edbc khi tri\u1ec3n khai s\u1ea3n xu\u1ea5t.", "sources": [{"id": "ISO-4628-1-2016", "document_family": "ISO-4628-1", "revision": "2016", "section": "Khung ph\u1ea1m vi v\u00e0 \u0111\u1ecbnh danh", "effective_date": "2020-01-01", "expiry_date": "2020-12-31", "document_status": "APPROVED", "title": "S\u01a1n v\u00e0 vecni \u2014 \u0110\u00e1nh gi\u00e1 suy gi\u1ea3m l\u1edbp ph\u1ee7 \u2014 Ph\u1ea7n 1", "scope": "\u0110\u1ecbnh danh s\u1ed1 l\u01b0\u1ee3ng, k\u00edch th\u01b0\u1edbc v\u00e0 m\u1ee9c \u0111\u1ed9 thay \u0111\u1ed5i ngo\u1ea1i quan c\u1ee7a l\u1ed7i; kh\u00f4ng ph\u1ea3i gi\u1edbi h\u1ea1n ch\u1ea5p nh\u1eadn th\u1ea9m m\u1ef9 c\u1ee7a OEM.", "url": "https://www.iso.org/standard/64877.html", "authority": "CONTROLLED_POLICY"}, {"id": "ISO-1101-2017", "document_family": "ISO-1101", "revision": "2017", "section": "Khung ph\u1ea1m vi v\u00e0 \u0111\u1eb7c t\u00ednh h\u00ecnh h\u1ecdc", "effective_date": null, "expiry_date": null, "document_status": "REFERENCE_ONLY", "title": "\u0110\u1eb7c t\u00ednh h\u00ecnh h\u1ecdc s\u1ea3n ph\u1ea9m \u2014 Dung sai h\u00ecnh h\u1ecdc", "scope": "Ng\u00f4n ng\u1eef v\u00e0 c\u00e1ch di\u1ec5n gi\u1ea3i \u0111\u1eb7c t\u00ednh h\u00ecnh h\u1ecdc; gi\u1edbi h\u1ea1n th\u1ef1c t\u1ebf ph\u1ea3i l\u1ea5y t\u1eeb b\u1ea3n v\u1ebd \u0111\u00e3 \u0111\u01b0\u1ee3c ph\u00ea duy\u1ec7t.", "url": "https://www.iso.org/standard/66777.html"}, {"id": "ISO-17637-2016", "document_family": "ISO-17637", "revision": "2016", "section": "Khung ph\u1ea1m vi v\u00e0 ph\u01b0\u01a1ng ph\u00e1p ki\u1ec3m tra b\u1eb1ng m\u1eaft", "effective_date": null, "expiry_date": null, "document_status": "REFERENCE_ONLY", "title": "Ki\u1ec3m tra kh\u00f4ng ph\u00e1 h\u1ee7y m\u1ed1i h\u00e0n \u2014 Ki\u1ec3m tra b\u1eb1ng m\u1eaft m\u1ed1i h\u00e0n n\u00f3ng ch\u1ea3y", "scope": "Ph\u01b0\u01a1ng ph\u00e1p ki\u1ec3m tra b\u1eb1ng m\u1eaft cho m\u1ed1i h\u00e0n n\u00f3ng ch\u1ea3y; c\u1ea7n x\u00e1c nh\u1eadn kh\u1ea3 n\u0103ng \u00e1p d\u1ee5ng cho t\u1eebng quy tr\u00ecnh h\u00e0n c\u1ee7a xe.", "url": "https://www.iso.org/standard/67259.html"}, {"id": "ISO-5817-2023", "document_family": "ISO-5817", "revision": "2023", "section": "Khung ph\u1ea1m vi v\u00e0 m\u1ee9c ch\u1ea5t l\u01b0\u1ee3ng", "effective_date": null, "expiry_date": null, "document_status": "REFERENCE_ONLY", "title": "H\u00e0n \u2014 M\u1ed1i h\u00e0n n\u00f3ng ch\u1ea3y \u2014 M\u1ee9c ch\u1ea5t l\u01b0\u1ee3ng cho c\u00e1c khuy\u1ebft t\u1eadt", "scope": "M\u1ee9c ch\u1ea5t l\u01b0\u1ee3ng B, C v\u00e0 D cho m\u1ed1i h\u00e0n n\u00f3ng ch\u1ea3y \u0111\u01b0\u1ee3c \u0111\u1ec1 c\u1eadp; kh\u00f4ng ph\u1ea3i m\u1ee9c ch\u1ea5p nh\u1eadn m\u1eb7c \u0111\u1ecbnh cho h\u00e0n \u0111i\u1ec3m \u00f4 t\u00f4.", "url": "https://www.iso.org/standard/80209.html"}, {"id": "ISO-3779-2009", "document_family": "ISO-3779", "revision": "2009", "section": "N\u1ed9i dung v\u00e0 c\u1ea5u tr\u00fac s\u1ed1 VIN", "effective_date": null, "expiry_date": null, "document_status": "REFERENCE_ONLY", "title": "Ph\u01b0\u01a1ng ti\u1ec7n giao th\u00f4ng \u0111\u01b0\u1eddng b\u1ed9 \u2014 S\u1ed1 nh\u1eadn d\u1ea1ng xe (VIN) \u2014 N\u1ed9i dung v\u00e0 c\u1ea5u tr\u00fac", "scope": "N\u1ed9i dung v\u00e0 c\u1ea5u tr\u00fac VIN \u00e1p d\u1ee5ng tr\u00ean to\u00e0n c\u1ea7u.", "url": "https://www.iso.org/standard/52200.html"}, {"id": "ISO-9001-2015", "document_family": "ISO-9001", "revision": "2015", "section": "Th\u00f4ng tin d\u1ea1ng v\u0103n b\u1ea3n v\u00e0 ki\u1ec3m so\u00e1t v\u1eadn h\u00e0nh", "effective_date": null, "expiry_date": null, "document_status": "REFERENCE_ONLY", "title": "H\u1ec7 th\u1ed1ng qu\u1ea3n l\u00fd ch\u1ea5t l\u01b0\u1ee3ng \u2014 C\u00e1c y\u00eau c\u1ea7u", "scope": "Th\u00f4ng tin d\u1ea1ng v\u0103n b\u1ea3n, ki\u1ec3m so\u00e1t v\u1eadn h\u00e0nh, theo d\u00f5i, \u0111o l\u01b0\u1eddng, \u0111\u00e1nh gi\u00e1 v\u00e0 c\u1ea3i ti\u1ebfn.", "url": "https://www.iso.org/standard/62085.html"}, {"id": "AIAG-CQI-8", "document_family": "AIAG-CQI-8", "revision": "publisher-current", "section": "Qu\u1ea3n tr\u1ecb \u0111\u00e1nh gi\u00e1 quy tr\u00ecnh ph\u00e2n l\u1edbp", "effective_date": null, "expiry_date": null, "document_status": "REFERENCE_ONLY", "title": "H\u01b0\u1edbng d\u1eabn \u0111\u00e1nh gi\u00e1 quy tr\u00ecnh ph\u00e2n l\u1edbp (LPA)", "scope": "X\u00e1c minh quy tr\u00ecnh c\u00f3 c\u1ea5u tr\u00fac, ph\u00e2n c\u00f4ng tr\u00e1ch nhi\u1ec7m, ph\u00e1t hi\u1ec7n l\u1ed7i v\u00e0 theo d\u00f5i hi\u1ec7u qu\u1ea3.", "url": "https://www.aiag.org/training-and-resources/manuals/details/CQI-8"}, {"id": "FNS-QC-POLICY-DEMO-2026", "document_family": "FNS-QC-POLICY", "revision": "2026.08.1", "section": "FNS-SURFACE-001 \u0111\u1ebfn FNS-TREND-001", "effective_date": "2026-08-12", "expiry_date": null, "document_status": "APPROVED", "authority": "CONTROLLED_POLICY", "title": "Ch\u00ednh s\u00e1ch tr\u00ecnh di\u1ec5n baseline QC b\u1eb1ng h\u00ecnh \u1ea3nh (FNS)", "scope": "Baseline n\u1ed9i b\u1ed9 \u0111\u01b0\u1ee3c ph\u00ea duy\u1ec7t t\u1ea1m th\u1eddi \u0111\u1ec3 tr\u00ecnh di\u1ec5n truy xu\u1ea5t t\u00e0i li\u1ec7u, so s\u00e1nh b\u1eb1ng ch\u1ee9ng, \u0111\u1ecbnh tuy\u1ebfn LangGraph, HITL v\u00e0 h\u00e0nh vi ki\u1ec3m to\u00e1n. Kh\u00f4ng c\u00f3 gi\u00e1 tr\u1ecb cho vi\u1ec7c ph\u00e1t h\u00e0nh xe s\u1ea3n xu\u1ea5t.", "url": "/api/policies"}, {"id": "ISO-4628-1-2024", "document_family": "ISO-4628-1", "revision": "2024", "section": "Khung ph\u1ea1m vi v\u00e0 \u0111\u1ecbnh danh", "effective_date": "2020-01-01", "expiry_date": null, "document_status": "APPROVED", "title": "S\u01a1n v\u00e0 vecni \u2014 \u0110\u00e1nh gi\u00e1 suy gi\u1ea3m l\u1edbp ph\u1ee7 \u2014 Ph\u1ea7n 1", "scope": "\u0110\u1ecbnh danh s\u1ed1 l\u01b0\u1ee3ng, k\u00edch th\u01b0\u1edbc v\u00e0 m\u1ee9c \u0111\u1ed9 thay \u0111\u1ed5i ngo\u1ea1i quan c\u1ee7a l\u1ed7i; kh\u00f4ng ph\u1ea3i gi\u1edbi h\u1ea1n ch\u1ea5p nh\u1eadn th\u1ea9m m\u1ef9 c\u1ee7a OEM.", "url": "https://www.iso.org/standard/64877.html", "authority": "CONTROLLED_POLICY"}], "policies": [{"id": "FNS-SURFACE-001", "title": "Ng\u0103n gi\u1eef v\u00e0 \u0111\u00e1nh gi\u00e1 l\u1ed7i b\u1ec1 m\u1eb7t", "applicability": {"vehicle_models": ["*"]}, "conditions": ["Lo\u1ea1i l\u1ed7i l\u00e0 tr\u1ea7y x\u01b0\u1edbc ho\u1eb7c l\u1ed7i s\u01a1n", "Ph\u1ea3i x\u00e1c \u0111\u1ecbnh \u0111\u01b0\u1ee3c m\u1ee9c \u0111\u1ed9 l\u1ed7i", "Ph\u1ea3i c\u00f3 ti\u00eau ch\u00ed th\u1ea9m m\u1ef9 OEM \u0111\u00e3 ph\u00ea duy\u1ec7t tr\u01b0\u1edbc khi xu\u1ea5t x\u01b0\u1edfng"], "checklist_status": "APPROVED", "defect_types": ["scratch", "paint_defect"], "action_code": "SURFACE_DAMAGE_ASSESSMENT_AND_REINSPECT", "final_status": "HOLD_FOR_QC", "test_drive_allowed": false, "human_required": false, "required_evidence": ["controlled_light_reinspection", "defect_extent_measurement", "approved_oem_acceptance_criteria"], "steps": ["CONTAIN_VEHICLE", "CAPTURE_CONTROLLED_LIGHT_IMAGE", "MEASURE_DEFECT_EXTENT", "APPLY_APPROVED_OEM_CRITERIA", "QC_SIGN_OFF"], "source_ids": ["ISO-4628-1-2016", "ISO-4628-1-2024"]}, {"id": "FNS-GEOMETRY-001", "title": "Ng\u0103n gi\u1eef bi\u1ebfn d\u1ea1ng b\u1ec1 m\u1eb7t v\u00e0 \u0111\u00e1nh gi\u00e1 h\u00ecnh h\u1ecdc", "applicability": {"vehicle_models": ["*"]}, "conditions": ["Lo\u1ea1i l\u1ed7i l\u00e0 m\u00f3p ho\u1eb7c n\u1ee9t", "Ph\u1ea3i \u0111o \u0111\u01b0\u1ee3c h\u00ecnh h\u1ecdc c\u1ee7a l\u1ed7i", "Ph\u1ea3i c\u00f3 ti\u00eau ch\u00ed h\u00ecnh h\u1ecdc \u0111\u00e3 ban h\u00e0nh tr\u01b0\u1edbc khi ra quy\u1ebft \u0111\u1ecbnh s\u1eeda ch\u1eefa"], "checklist_status": "APPROVED", "defect_types": ["dent", "crack"], "action_code": "ISOLATE_FOR_BODY_REPAIR_ASSESSMENT", "final_status": "HOLD_FOR_REWORK", "test_drive_allowed": false, "human_required": false, "required_evidence": ["approved_geometry_criteria", "geometry_measurement", "body_repair_signoff"], "steps": ["APPLY_HOLD", "TRANSFER_TO_BODY_REPAIR_ASSESSMENT", "MEASURE_PANEL_GEOMETRY", "COMPARE_WITH_APPROVED_DRAWING", "QC_REINSPECTION"], "source_ids": ["FNS-QC-POLICY-DEMO-2026", "ISO-1101-2017", "ISO-9001-2015"]}, {"id": "FNS-SAFETY-001", "title": "Ng\u0103n gi\u1eef h\u01b0 h\u1ecfng li\u00ean quan an to\u00e0n c\u00f3 th\u1ec3 quan s\u00e1t \u0111\u01b0\u1ee3c", "applicability": {"vehicle_models": ["*"]}, "conditions": ["H\u01b0 h\u1ecfng quan s\u00e1t \u0111\u01b0\u1ee3c \u1ea3nh h\u01b0\u1edfng \u0111\u1ebfn k\u00ednh, \u0111\u00e8n ho\u1eb7c an to\u00e0n l\u1ed1p", "Xe v\u1eabn b\u1ecb ch\u1eb7n di chuy\u1ec3n cho \u0111\u1ebfn khi c\u00f3 \u0111\u00e1nh gi\u00e1 c\u1ee7a chuy\u00ean gia"], "checklist_status": "APPROVED", "defect_types": ["glass_shatter", "lamp_broken", "tire_flat"], "action_code_by_defect": {"glass_shatter": "ISOLATE_FOR_GLASS_REPAIR", "lamp_broken": "ISOLATE_FOR_LIGHTING_REPAIR", "tire_flat": "IMMOBILIZE_FOR_TIRE_SERVICE"}, "final_status": "HOLD_FOR_REWORK", "test_drive_allowed": false, "human_required": true, "required_evidence": ["specialist_assessment", "approved_repair_instruction", "qc_reinspection"], "steps": ["IMMOBILIZE_OR_CONTAIN", "ESCALATE_TO_SPECIALIST", "APPLY_APPROVED_REPAIR_INSTRUCTION", "QC_REINSPECTION"], "source_ids": ["FNS-QC-POLICY-DEMO-2026", "ISO-9001-2015"]}, {"id": "FNS-WELD-001", "title": "Qu\u1ea3n tr\u1ecb ki\u1ec3m tra b\u1eb1ng m\u1eaft m\u1ed1i h\u00e0n", "applicability": {"vehicle_models": ["*"]}, "conditions": ["Ph\u1ea3i x\u00e1c \u0111\u1ecbnh quy tr\u00ecnh h\u00e0n v\u00e0 ti\u00eau chu\u1ea9n \u00e1p d\u1ee5ng", "Ph\u1ea3i c\u00f3 m\u1ee9c ch\u1ea5p nh\u1eadn \u0111\u00e3 ph\u00ea duy\u1ec7t v\u00e0 ng\u01b0\u1eddi ki\u1ec3m tra \u0111\u1ee7 n\u0103ng l\u1ef1c"], "checklist_status": "APPROVED", "defect_types": ["weld_imperfection"], "action_code": "HOLD_FOR_WELD_ENGINEERING_REVIEW", "final_status": "HOLD_FOR_REWORK", "test_drive_allowed": false, "human_required": true, "required_evidence": ["weld_process_identification", "approved_weld_acceptance_level", "qualified_visual_examiner", "measurement_or_ndt_result"], "steps": ["IDENTIFY_WELD_PROCESS", "CONFIRM_STANDARD_APPLICABILITY", "PERFORM_APPROVED_VISUAL_TEST", "APPLY_APPROVED_ACCEPTANCE_LEVEL", "QUALITY_SIGN_OFF"], "source_ids": ["FNS-QC-POLICY-DEMO-2026", "ISO-17637-2016", "ISO-5817-2023", "ISO-9001-2015"]}, {"id": "FNS-VIN-001", "title": "X\u00e1c minh c\u1ea5u tr\u00fac VIN v\u00e0 danh t\u00ednh xe", "applicability": {"vehicle_models": ["*"]}, "conditions": ["VIN kh\u00f4ng \u0111\u1ecdc \u0111\u01b0\u1ee3c ho\u1eb7c kh\u00f4ng kh\u1edbp h\u1ed3 s\u01a1 xe", "Ph\u1ea3i c\u00f3 c\u1ea3 quy \u0111\u1ecbnh th\u1ecb tr\u01b0\u1eddng v\u00e0 h\u1ed3 s\u01a1 s\u1ea3n xu\u1ea5t"], "checklist_status": "APPROVED", "defect_types": ["vin_mismatch", "vin_unreadable"], "action_code": "HOLD_FOR_VIN_VERIFICATION", "final_status": "HOLD_FOR_QC", "test_drive_allowed": false, "human_required": true, "required_evidence": ["vin_capture", "vehicle_build_record", "approved_market_vin_validation"], "steps": ["HOLD_VEHICLE", "RECAPTURE_VIN", "VALIDATE_STRUCTURE", "COMPARE_BUILD_RECORD", "AUTHORIZED_SIGN_OFF"], "source_ids": ["FNS-QC-POLICY-DEMO-2026", "ISO-3779-2009", "ISO-9001-2015"]}, {"id": "FNS-TREND-001", "title": "Leo thang l\u00ean ngu\u1ed3n cho l\u1ed7i l\u1eb7p l\u1ea1i", "applicability": {"vehicle_models": ["*"]}, "conditions": ["S\u1ed1 l\u1ea7n ph\u00e1t hi\u1ec7n l\u1eb7p l\u1ea1i v\u01b0\u1ee3t ng\u01b0\u1ee1ng xe \u0111\u00e3 c\u1ea5u h\u00ecnh", "Camera, khu v\u1ef1c ki\u1ec3m tra v\u00e0 khung th\u1eddi gian \u0111\u01b0\u1ee3c nh\u00f3m nh\u1ea5t qu\u00e1n"], "checklist_status": "APPROVED", "defect_types": ["*"], "action_code": "OPEN_UPSTREAM_PROCESS_CHECK", "final_status": "QUALITY_ALERT_OPEN", "test_drive_allowed": null, "human_required": true, "required_evidence": ["affected_vehicle_list", "time_window", "camera_and_zone_group", "process_owner", "corrective_action_record"], "steps": ["CONTAIN_AFFECTED_SCOPE", "VERIFY_DETECTION_SYSTEM", "CHECK_UPSTREAM_PROCESS", "ASSIGN_OWNER", "RECORD_CORRECTIVE_ACTION"], "source_ids": ["FNS-QC-POLICY-DEMO-2026", "AIAG-CQI-8", "ISO-9001-2015"]}]}