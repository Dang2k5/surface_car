VITE_API_BASE_URL=http://127.0.0.1:8000

# Supabase Auth (frontend signs in directly against Supabase, never through the backend —
# API_CONTRACT.md §7.7). VITE_SUPABASE_ANON_KEY is the public anon key; safe to expose in the
# browser by Supabase's design. Leave both blank to run the login screen in dev-bypass mode
# (matches backend SUPABASE_JWT_SECRET unset — see ../.env.example).
VITE_SUPABASE_URL=https://PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=
