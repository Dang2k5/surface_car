# Visual QC Agent - local configuration
# Copy this file to .env. Never commit the resulting .env file.

# SQLite database for the local pilot.
DATABASE_URL=sqlite:///./data/visual_qc.db

# Real local Ultralytics segmentation model.
DETECTOR_PROVIDER=local_yolo
MODEL_PATH=./data/best.pt
MODEL_DEVICE=cpu
MODEL_CONFIDENCE=0.25
MODEL_IMAGE_SIZE=1280

# Pilot safety: no detection is routed to QC instead of automatic PASS.
AUTO_PASS_ENABLED=false
CONFIRMED_THRESHOLD=0.70
VERIFY_THRESHOLD=0.40

# Optional observability. Local inference is offline by default.
# Only enable this after providing a valid LangSmith API key and project.
ENABLE_LANGSMITH_TRACING=false
LANGSMITH_TRACING=false
LANGCHAIN_TRACING_V2=false
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=visual-qc-local
