# Visual QC Agent - local runtime configuration
# Copy to .env. Never commit .env or place secrets in frontend variables.

# 1. Database
DATABASE_URL=sqlite:///./data/visual_qc.db

# 2. Computer Vision - local Ultralytics segmentation
DETECTOR_PROVIDER=local_yolo
MODEL_PATH=./data/best.pt
MODEL_DEVICE=cpu
MODEL_CONFIDENCE=0.25
MODEL_IMAGE_SIZE=1280

# 3. LangGraph decision thresholds
# Keep false until the plant policy and release authority are approved.
AUTO_PASS_ENABLED=false
CONFIRMED_THRESHOLD=0.70
VERIFY_THRESHOLD=0.40

# 4. Optional reasoning copilot
# deterministic: no external API; groq: requires a fresh server-side key.
QC_REASONING_PROVIDER=deterministic
GROQ_MODEL=openai/gpt-oss-20b
GROQ_API_KEY=

# 5. Optional LangSmith tracing - disabled by default
ENABLE_LANGSMITH_TRACING=false
LANGSMITH_TRACING=false
LANGCHAIN_TRACING_V2=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=visual-qc-local

# 6. Legacy/reserved compatibility values
# Preserved for the previous setup; the current MVP does not read these directly.
QC_LLM_AUTO_EXPLAIN=false
CHROMA_PERSIST_DIR=./data/chroma
APP_ENV=development
APP_PORT=8000
APP_HOST=127.0.0.1
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
AI_LOG_SERVER=
AI_LOG_API_KEY=
AI_LOG_DIR=./logs
