# Visual QC Agent - local runtime configuration
# Copy to .env. Never commit .env or place secrets in frontend variables.

# 1. Database
# Local development (currently active)
DATABASE_URL=sqlite:///./data/visual_qc.db

# Supabase PostgreSQL (use the Session pooler on port 5432 for persistent FastAPI):
# DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
# Never put this URL in NEXT_PUBLIC_* variables or commit the real password.

# 2. Computer Vision - local Ultralytics segmentation
DETECTOR_PROVIDER=local_yolo
MODEL_PATH=./data/best.pt
MODEL_DEVICE=cpu
MODEL_CONFIDENCE=0.25
MODEL_IMAGE_SIZE=640

# Pilot fixed-camera conversion. The source camera pose, lens and resolution
# must remain unchanged; MODEL_IMAGE_SIZE only controls YOLO inference resizing.
# This is an estimate, not a QC-certified measurement.
FIXED_CAMERA_CALIBRATION_ENABLED=true
CALIBRATION_MM_PER_PIXEL_X=0.8
CALIBRATION_MM_PER_PIXEL_Y=0.8
CALIBRATION_PROFILE_ID=FNS_FRONT_PILOT_1280

# 3. LangGraph decision thresholds
# Keep false until the plant policy and release authority are approved.
AUTO_PASS_ENABLED=true
CONFIRMED_THRESHOLD=0.70
VERIFY_THRESHOLD=0.40

# 4. LLM decision Agent
# groq: production/demo runtime. deterministic is only for tests and diagnostics.
QC_REASONING_PROVIDER=groq
GROQ_MODEL=openai/gpt-oss-20b
GROQ_API_KEY=

# 5. Portable Agent audit export
AUDIT_AUTO_EXPORT_ENABLED=true
AUDIT_EXPORT_DIR=./data/exports

# 6. Backend runtime and browser access
APP_ENV=development
APP_PORT=8000
APP_HOST=127.0.0.1
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOG_LEVEL=INFO

# 7. Optional LangSmith tracing - disabled by default
ENABLE_LANGSMITH_TRACING=false
LANGSMITH_TRACING=false
LANGCHAIN_TRACING_V2=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=visual-qc-local

# 8. AI activity logging used by repository hooks
AI_LOG_SERVER=
AI_LOG_API_KEY=
AI_LOG_DIR=.ai-log

# 9. Legacy/reserved compatibility values
# Preserved for older tooling; the current Visual QC runtime does not read them.
QC_LLM_AUTO_EXPLAIN=false
CHROMA_PERSIST_DIR=./data/chroma
