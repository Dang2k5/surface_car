# Visual QC Agent - local runtime configuration
# Copy to .env. Never commit .env or place secrets in frontend variables.

# 1. Database
# PostgreSQL only (Supabase). Use the Session pooler on port 5432 for persistent FastAPI.
# Never put this URL in NEXT_PUBLIC_* variables or commit the real password.
DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require

# 1a. Tests only: isolates each pytest run in a throwaway schema on the same
# Supabase project above instead of touching real data. Set automatically per test
# by tests/conftest.py -- do not set this manually for the running backend.
# DATABASE_SCHEMA=

# 1b. Object Storage (AWS S3)
# Leave S3_ACCESS_KEY/S3_SECRET_KEY blank to use local disk (./data/uploads)
# with zero setup — same behavior as before this was configurable.
# OBJECT_STORAGE_PROVIDER=s3
# S3_ENDPOINT=
# S3_BUCKET=visual-qc
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_REGION=

# 2. Computer Vision - local Ultralytics segmentation
# This branch targets AWS EC2 GPU (g4dn.xlarge) -- MODEL_DEVICE=cuda:0.
# The CPU/Railway branch keeps MODEL_DEVICE=cpu; see docs/ENVIRONMENT.md.
DETECTOR_PROVIDER=local_yolo
MODEL_PATH=./data/best.pt
MODEL_DEVICE=cuda:0
MODEL_CONFIDENCE=0.25
# GPU has latency headroom the CPU branch's 640 doesn't -- 1280 trades that
# headroom for detection accuracy. Confirm with a real P95 benchmark first
# (docs/DEPLOYMENT_PLAN_AWS_GPU.md) before raising this in production.
MODEL_IMAGE_SIZE=640

# Pilot fixed-camera conversion. The source camera pose, lens and resolution
# must remain unchanged; MODEL_IMAGE_SIZE only controls YOLO inference resizing.
# This is an estimate, not a QC-certified measurement.
FIXED_CAMERA_CALIBRATION_ENABLED=true
CALIBRATION_MM_PER_PIXEL_X=0.8
CALIBRATION_MM_PER_PIXEL_Y=0.8
CALIBRATION_PROFILE_ID=FNS_FRONT_PILOT_1280

# Optional: per-shot correction using a fixed-size ArUco marker glued to the
# inspection fixture. When enabled and the marker is detected, mm/pixel is
# computed fresh from the marker's measured side length in that frame instead
# of trusting the static ratio above — corrects for the vehicle standing off
# the nominal position. Falls back to the static ratio if no marker is found.
MARKER_CALIBRATION_ENABLED=false
MARKER_SIZE_MM=50
MARKER_DICTIONARY=DICT_4X4_50

# 3. LangGraph decision thresholds
# Keep false until the plant policy and release authority are approved.
AUTO_PASS_ENABLED=true
CONFIRMED_THRESHOLD=0.70
VERIFY_THRESHOLD=0.40

# 4. LLM decision Agent
# groq: production/demo runtime. deterministic is only for tests and diagnostics.
QC_REASONING_PROVIDER=groq
GROQ_MODEL=openai/gpt-oss-20b
GROQ_API_KEY=

# 5. Backend runtime and browser access
# APP_PORT/APP_HOST/LOG_LEVEL are not read anywhere in code (uvicorn's host/port
# come from the CLI command that starts it) -- removed to avoid implying they do
# something. Only these two are actually consumed:
APP_ENV=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# 6. Optional LangSmith tracing - disabled by default
ENABLE_LANGSMITH_TRACING=false
LANGSMITH_TRACING=false
LANGCHAIN_TRACING_V2=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=visual-qc-local

# 7. AI activity logging used by repository hooks
AI_LOG_SERVER=
AI_LOG_API_KEY=
AI_LOG_DIR=.ai-log

# 8. Authentication & RBAC (Supabase Auth, API_CONTRACT.md §7.7)
# Leave both SUPABASE_URL and SUPABASE_JWT_SECRET blank for local dev: RBAC is disabled and
# every request is treated as an authenticated dev user (role selectable via the frontend's
# X-Dev-Role header). To enforce real RBAC, set ONE of the two below depending on how your
# Supabase project signs access tokens (Project Settings > API > JWT Settings):
#   - Newer projects (API-key system, "Signing Keys" only, ES256/RS256) -> set SUPABASE_URL;
#     the backend verifies tokens against the project's JWKS endpoint, no shared secret needed.
#   - Older/legacy projects that still expose a "JWT Secret" (HS256) -> set SUPABASE_JWT_SECRET
#     instead (takes priority over SUPABASE_URL if both are set).
# The backend never issues or stores passwords either way — it only verifies tokens Supabase
# Auth already signed.
SUPABASE_URL=
SUPABASE_JWT_SECRET=
# Role assigned to profiles.role the first time a new Supabase user calls an authenticated
# endpoint. Valid values: QC_OPERATOR, QC_SUPERVISOR. Promoting a user to QC_SUPERVISOR is a
# manual admin action (Supabase dashboard/SQL), not exposed as an API in this MVP.
DEFAULT_QC_ROLE=QC_OPERATOR
