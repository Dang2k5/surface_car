{
  "description": "Send Codex lifecycle events to AI Log",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 scripts/log_hook.py --tool=codex",
            "commandWindows": "python scripts\\log_hook.py --tool=codex",
            "timeout": 10,
            "statusMessage": "Saving prompt to AI Log"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 scripts/log_hook.py --tool=codex",
            "commandWindows": "python scripts\\log_hook.py --tool=codex",
            "timeout": 10,
            "statusMessage": "Saving Codex response to AI Log"
          }
        ]
      }
    ]
  }
}